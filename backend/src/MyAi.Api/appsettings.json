{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=myai;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "MyAi",
    "Audience": "MyAi",
    "ExpireDays": 30
  },
  "Encryption": {
    "Key": "CHANGE-ME-in-production-user-api-key-encryption-secret"
  },
  "AI": {
    "ApiKey": "",
    "Model": "gemini-2.5-flash"
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "Endpoint": "localhost:6379"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}